# ═══════════════════════════════════════════════════════════════
#  .env PRODUKSI — server 172.20.0.39
#
#  CARA PAKAI:
#    1. Salin berkas ini ke server produksi sebagai `.env`
#       (di C:\xampp\htdocs\antrian\.env)
#    2. Isi bagian DB_PASSWORD & username sesuai MySQL produksi
#    3. Jalankan:  php artisan key:generate
#    4. Jalankan:  php artisan migrate --force
#    5. Jalankan:  php artisan config:clear
#
#  JANGAN salin berkas ini ke repo/git — berisi kredensial.
# ═══════════════════════════════════════════════════════════════

APP_NAME="CIHOS Queue"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://172.20.0.39/antrian

# Path RELATIF — aset tetap benar walau diakses lewat IP lain,
# hostname, atau URL pendek /display.
ASSET_URL=/antrian

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Di produksi cukup catat peringatan & error, bukan semua debug.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ═══════════════════════════════════════════════════════════════
#  DATABASE — 4 koneksi MySQL, semuanya di server yang sama
# ═══════════════════════════════════════════════════════════════

# ── 1) UTAMA: data antrian, hak akses (antrian_access), sesi, cache
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=antrian_cihos
DB_USERNAME=root
DB_PASSWORD=

# ── 2) MASTER: dokter, jadwal praktik, klinik, prefix ruang
MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=3306
MASTER_DB_DATABASE=cihos_master
MASTER_DB_USERNAME=root
MASTER_DB_PASSWORD=

# ── 3) APPOINTMENT: SUMBER DATA ANTRIAN
#    Dibaca LANGSUNG (bukan lewat HTTP API). Semua registrasi — dari
#    aplikasi appointment, TapTalk/WA bot, maupun Kiosk — pasti lewat
#    tabel ini sebelum dikirim ke MEDINFRAS.
APPT_DB_HOST=127.0.0.1
APPT_DB_PORT=3306
APPT_DB_DATABASE=appointment_pasien_cihos
APPT_DB_USERNAME=root
APPT_DB_PASSWORD=

# ── 4) DBUSER: direktori user RS — verifikasi password saat login
DBUSER_HOST=127.0.0.1
DBUSER_PORT=3306
DBUSER_DATABASE=dbuser
DBUSER_USERNAME=root
DBUSER_PASSWORD=

# ═══════════════════════════════════════════════════════════════
#  SESI
# ═══════════════════════════════════════════════════════════════
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
# WAJIB /antrian — memisahkan cookie sesi dari aplikasi appointment
# yang berada di server & domain yang sama.
SESSION_PATH=/antrian
SESSION_DOMAIN=null
SESSION_COOKIE=antrian_session

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ═══════════════════════════════════════════════════════════════
#  SUARA PENGUMUMAN (TTS)
# ═══════════════════════════════════════════════════════════════
# edge  → Microsoft Edge TTS, voice Indonesia neural. Butuh internet
#         saat merender kalimat BARU; hasilnya di-cache di public/tts
#         sehingga tiap kalimat hanya sekali online.
# piper → offline penuh (lihat SUARA-INDONESIA.md), hanya 1 voice
#         Indonesia & terdengar lebih robotik.
TTS_ENGINE=edge
TTS_ENABLED=true

# Voice: id-ID-GadisNeural (wanita) / id-ID-ArdiNeural (pria)
TTS_EDGE_VOICE="id-ID-GadisNeural"
TTS_EDGE_RATE="+8%"
TTS_EDGE_PITCH="-12Hz"

# local   = tiap layar berbunyi sendiri (dipakai sekarang)
# central = layar diam; hanya PC yang membuka /display/speaker berbunyi
TTS_SOUND_MODE=local

# Perintah python untuk Edge TTS (server produksi wajib: pip install edge-tts)
TTS_PYTHON=python

# Piper — hanya dipakai bila TTS_ENGINE=piper
TTS_BINARY="C:\piper\piper.exe"
TTS_MODEL="C:\piper\id_ID-news_tts-medium.onnx"
TTS_LENGTH_SCALE=1.15

# ═══════════════════════════════════════════════════════════════
#  Lain-lain (biarkan apa adanya)
# ═══════════════════════════════════════════════════════════════
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ciputrahospital.com"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
