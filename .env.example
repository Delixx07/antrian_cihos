APP_NAME="CIHOS Queue"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1/antrian

# Basis URL aset (gambar, audio). Pakai path RELATIF agar tidak rusak
# saat IP server berubah atau halaman dibuka lewat URL pendek /display.
ASSET_URL=/antrian

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ─────────────────────────────────────────────────────────────
# DATABASE — aplikasi ini memakai 4 koneksi MySQL
# ─────────────────────────────────────────────────────────────

# 1) Utama: data antrian & hak akses (antrian_access)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=antrian_cihos
DB_USERNAME=
DB_PASSWORD=

# 2) Master: dokter, jadwal, klinik, prefix ruang
MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=3306
MASTER_DB_DATABASE=cihos_master
MASTER_DB_USERNAME=
MASTER_DB_PASSWORD=

# 3) Appointment: SUMBER DATA ANTRIAN (dibaca langsung, bukan lewat API)
APPT_DB_HOST=127.0.0.1
APPT_DB_PORT=3306
APPT_DB_DATABASE=appointment_pasien_cihos
APPT_DB_USERNAME=
APPT_DB_PASSWORD=

# 4) Direktori user RS — untuk verifikasi password saat login
DBUSER_HOST=127.0.0.1
DBUSER_PORT=3306
DBUSER_DATABASE=dbuser
DBUSER_USERNAME=
DBUSER_PASSWORD=

# ─────────────────────────────────────────────────────────────
# SESI
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
# WAJIB /antrian — memisahkan sesi dari aplikasi lain di server yang sama
SESSION_PATH=/antrian
SESSION_DOMAIN=null
SESSION_COOKIE=antrian_session

CACHE_STORE=database
QUEUE_CONNECTION=database

# ─────────────────────────────────────────────────────────────
# SUARA PENGUMUMAN (TTS)
# ─────────────────────────────────────────────────────────────
# edge  = Microsoft Edge TTS, voice Indonesia neural (butuh internet
#         saat merender; hasil di-cache di public/tts)
# piper = offline penuh, hanya 1 voice Indonesia (lihat SUARA-INDONESIA.md)
TTS_ENGINE=edge
TTS_ENABLED=true

# Voice: id-ID-GadisNeural (wanita) / id-ID-ArdiNeural (pria)
TTS_EDGE_VOICE="id-ID-GadisNeural"
TTS_EDGE_RATE="+8%"
TTS_EDGE_PITCH="-12Hz"

# local   = tiap layar berbunyi sendiri
# central = layar diam, hanya PC yang membuka /display/speaker yang berbunyi
TTS_SOUND_MODE=local

# Perintah python (untuk Edge TTS). Sesuaikan bila memakai virtualenv.
TTS_PYTHON=python

# Piper (dipakai hanya bila TTS_ENGINE=piper)
TTS_BINARY="C:\piper\piper.exe"
TTS_MODEL="C:\piper\id_ID-news_tts-medium.onnx"
TTS_LENGTH_SCALE=1.15
